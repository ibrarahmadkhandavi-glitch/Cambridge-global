<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CarBridge Global</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f5f7fa;color:#17202a}
header{background:#07111f;color:white;padding:25px 18px;text-align:center}
header h1{margin:0;font-size:34px}
header p{margin:8px 0;color:#b9c7d6}
nav{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:18px}
button{border:0;border-radius:10px;padding:13px 18px;font-weight:bold;cursor:pointer}
.buy{background:#18a558;color:white}
.sell{background:#ffb703;color:#111}
.container{max-width:1000px;margin:auto;padding:25px 18px}
.card{background:white;border-radius:16px;padding:20px;margin-bottom:20px;box-shadow:0 4px 18px #0001}
.car{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.car img{width:100%;border-radius:14px}
.price{font-size:28px;font-weight:bold;color:#0b7a42}
.badge{display:inline-block;background:#e8f7ef;color:#08733c;padding:6px 10px;border-radius:20px;font-size:13px}
form{display:grid;gap:12px}
input,select{padding:14px;border:1px solid #ccd3da;border-radius:9px;font-size:16px}
.result{font-size:22px;font-weight:bold;margin-top:12px}
footer{text-align:center;background:#07111f;color:white;padding:25px;margin-top:30px}
@media(max-width:700px){.car{grid-template-columns:1fr}}
</style>
</head>

<body>

<header>
<h1>🚗 CarBridge Global</h1>
<p>Buy • Sell • Connect</p>

<nav>
<button class="buy" onclick="document.getElementById('cars').scrollIntoView()">BUY A CAR</button>
<button class="sell" onclick="document.getElementById('sell').scrollIntoView()">SELL YOUR CAR</button>
</nav>
</header>

<div class="container">

<section id="cars" class="card">
<h2>🔥 Featured Cars</h2>

<div class="car">
<div>
<img src="https://images.unsplash.com/photo-1552519507-da3b142c6e3d?auto=format&fit=crop&w=900&q=80">
</div>

<div>
<span class="badge">🇦🇪 Dubai</span>
<h2>Toyota Prado</h2>
<p>Model: 2018</p>
<p>Location: Dubai, UAE</p>
<p class="price">AED 60,000</p>

<button class="buy" onclick="contactSeller()">CONTACT SELLER</button>
</div>
</div>
</section>

<section id="sell" class="card">
<h2>📤 Sell Your Car</h2>
<p>Submit your vehicle details and connect with interested buyers.</p>

<form onsubmit="submitCar(event)">
<input id="name" placeholder="Your Name" required>
<input id="car" placeholder="Car Make & Model" required>
<input id="year" type="number" placeholder="Year" required>
<input id="price" type="number" placeholder="Asking Price (AED)" required>
<input id="location" placeholder="Location e.g. Dubai" required>
<input id="phone" placeholder="WhatsApp Number" required>
<button class="sell" type="submit">SUBMIT CAR</button>
</form>

<p id="submitted"></p>
</section>

<section class="card">
<h2>💰 Commission Calculator</h2>

<input id="salePrice" type="number" placeholder="Vehicle Sale Price (AED)" oninput="calculate()">

<select id="rate" onchange="calculate()">
<option value="1">1% Commission</option>
<option value="2">2% Commission</option>
<option value="3">3% Commission</option>
</select>

<div id="commission" class="result">Commission: AED 0</div>
</section>

<section class="card">
<h2>🤝 How CarBridge Works</h2>
<p>1️⃣ Seller submits a vehicle.</p>
<p>2️⃣ CarBridge publishes the listing.</p>
<p>3️⃣ Buyer contacts the seller.</p>
<p>4️⃣ Buyer and seller complete their transaction.</p>
<p>5️⃣ Any brokerage/commission is handled according to the agreed terms.</p>
</section>

</div>

<footer>
<p>© 2026 CarBridge Global</p>
<p>Dubai • UAE</p>
</footer>

<script>
function calculate(){
const price=Number(document.getElementById("salePrice").value)||0;
const rate=Number(document.getElementById("rate").value);
const commission=price*rate/100;
document.getElementById("commission").innerText=
"Commission: AED "+commission.toLocaleString();
}

function contactSeller(){
const message=encodeURIComponent(
"Hello, I am interested in the Toyota Prado listed on CarBridge Global."
);
window.open("https://wa.me/?text="+message,"_blank");
}

function submitCar(e){
e.preventDefault();

const name=document.getElementById("name").value;
const car=document.getElementById("car").value;
const price=document.getElementById("price").value;
const location=document.getElementById("location").value;

document.getElementById("submitted").innerHTML=
"✅ Listing submitted: "+car+
" — AED "+Number(price).toLocaleString()+
" — "+location+
"<br><br><b>Next:</b> CarBridge admin should verify the listing before publishing.";
}
</script>

</body>
</html>
